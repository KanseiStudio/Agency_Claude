{
  "name": "kansei-studio-agency",
  "version": "0.1.0",
  "private": true,
  "description": "Kansei-Studio Agency — agenzia di comunicazione virtuale AI-driven (Next.js + MySQL + n8n)",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rimraf node_modules .turbo",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yaml,yml}\"",
    "db:up": "docker compose up -d mysql adminer",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d mysql adminer",
    "db:generate": "pnpm --filter @kansei/database prisma:generate",
    "db:migrate": "pnpm --filter @kansei/database prisma:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @kansei/database prisma:migrate:deploy",
    "db:studio": "pnpm --filter @kansei/database prisma:studio",
    "db:seed": "pnpm --filter @kansei/database prisma:seed",
    "db:format": "pnpm --filter @kansei/database prisma:format"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
