# Template delle variabili d'ambiente del monorepo.
#
# Per usare in locale:
#   1. Copia questo file in `.env` (al root del progetto)
#   2. Modifica i valori dove serve
#   3. NON committare mai .env (è già in .gitignore)
#
# I valori qui presenti sono quelli usati in dev locale con Docker Compose.

# =========================================================================
# DATABASE (MySQL via Docker Compose)
# =========================================================================
# Credenziali del container MySQL definito in docker-compose.yml.
MYSQL_ROOT_PASSWORD=rootpassword_change_me
MYSQL_DATABASE=kansei_agency
MYSQL_USER=kansei
MYSQL_PASSWORD=kansei_dev_password

# Stringa di connessione completa usata da Prisma per l'applicazione.
# Sintassi: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=...
DATABASE_URL="mysql://kansei:kansei_dev_password@localhost:3307/kansei_agency"

# Shadow database URL: usato da Prisma SOLO durante `prisma migrate dev`
# per validare le migrazioni in un DB temporaneo prima di applicarle al
# DB reale. Richiede privilegi CREATE/DROP DATABASE, quindi in dev
# usiamo root. In produzione si configura un utente migrations dedicato.
SHADOW_DATABASE_URL="mysql://root:rootpassword_change_me@localhost:3307/kansei_shadow"

# =========================================================================
# AUTH (NextAuth v5 / Auth.js)
# =========================================================================
# AUTH_SECRET: usato per firmare i JWT delle sessioni.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change_me_with_a_strong_random_string

# AUTH_TRUST_HOST: necessario in dev e quando l'app è dietro reverse proxy.
AUTH_TRUST_HOST=true

# Password dell'admin Michele in dev. Cambiala in produzione.
DEV_ADMIN_PASSWORD=kansei-dev-2026!

# =========================================================================
# PROVIDER LLM / AI (popolare quando attiveremo gli agenti)
# =========================================================================
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_AI_API_KEY=
FAL_API_KEY=

# =========================================================================
# n8n (verrà aggiunto in fase successiva)
# =========================================================================
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change_me

# =========================================================================
# STORAGE
# =========================================================================
# Provider attivo: 'local' (filesystem) o 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage

# Configurazione S3 (usata solo se STORAGE_PROVIDER=s3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# =========================================================================
# PAGAMENTI (verranno usati quando attiveremo il flusso pagamento)
# =========================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# =========================================================================
# MAIL TRANSAZIONALE (verrà attivata quando ci sarà il primo flusso email)
# =========================================================================
RESEND_API_KEY=
MAIL_FROM_ADDRESS=no-reply@kansei-studio.art
MAIL_FROM_NAME="Kansei-Studio Agency"
