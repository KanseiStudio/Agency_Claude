# Template delle variabili d'ambiente del monorepo.
#
# Per usare in locale:
#   1. Copia questo file in `.env` (al root del progetto)
#   2. Modifica i valori dove serve
#   3. NON committare mai .env (è già in .gitignore)
#
# I valori qui presenti sono quelli usati in dev locale con Docker Compose.

# =========================================================================
# DATABASE (MySQL via Docker Compose)
# =========================================================================
# Credenziali del container MySQL definito in docker-compose.yml.
MYSQL_ROOT_PASSWORD=rootpassword_change_me
MYSQL_DATABASE=kansei_agency
MYSQL_USER=kansei
MYSQL_PASSWORD=kansei_dev_password

# Stringa di connessione completa usata da Prisma per l'applicazione.
# Sintassi: mysql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=...
DATABASE_URL="mysql://kansei:kansei_dev_password@localhost:3307/kansei_agency"

# Shadow database URL: usato da Prisma SOLO durante `prisma migrate dev`
# per validare le migrazioni in un DB temporaneo prima di applicarle al
# DB reale. Richiede privilegi CREATE/DROP DATABASE, quindi in dev
# usiamo root. In produzione si configura un utente migrations dedicato.
SHADOW_DATABASE_URL="mysql://root:rootpassword_change_me@localhost:3307/kansei_shadow"

# =========================================================================
# AUTH (NextAuth v5 / Auth.js)
# =========================================================================
# AUTH_SECRET: usato per firmare i JWT delle sessioni.
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=change_me_with_a_strong_random_string

# AUTH_TRUST_HOST: necessario in dev e quando l'app è dietro reverse proxy.
AUTH_TRUST_HOST=true

# Password dell'admin Michele in dev. Cambiala in produzione.
DEV_ADMIN_PASSWORD=kansei-dev-2026!

# Password del cliente demo in dev. Usata da apps/client per il login di test.
DEV_CLIENT_PASSWORD=cliente-dev-2026!

# =========================================================================
# PROVIDER LLM / AI
# =========================================================================
# Imposta MOCK_LLM=true per usare risposte canned in dev (default consigliato
# finché non hai validato il flusso e vuoi spendere su Anthropic/OpenAI).
# Imposta MOCK_LLM=false (o cancella la riga) e fornisci le chiavi reali per
# usare i provider veri.
MOCK_LLM=true

ANTHROPIC_API_KEY=
# OPENAI_API_KEY: REQUIRED per la generazione delle immagini / keyframe via
# OpenAI Images API (modello gpt-image-1). Formato: sk-...
OPENAI_API_KEY=
# Modello API di default per Images. Quando OpenAI rilascia un model id nuovo
# (es. gpt-image-2) basta cambiare qui senza toccare il registry.
OPENAI_IMAGE_MODEL=gpt-image-1
# Quality: "low" | "medium" | "high" | "auto"
OPENAI_IMAGE_QUALITY=high
# GOOGLE_AI_API_KEY: opzionale, per eventuali agenti LLM su Gemini.
GOOGLE_AI_API_KEY=
# ADMIN_PUBLIC_BASE_URL: usato dal flusso video per costruire URL pubbliche dei
# keyframe da passare al modello video (Seedance ecc.). In dev è localhost:3001,
# in prod metti il dominio reale (https://admin.tuodominio.it).
ADMIN_PUBLIC_BASE_URL=http://localhost:3001

# -------------------------------------------------------------------------
# HIGGSFIELD (image + video generation)
# -------------------------------------------------------------------------
# Higgsfield espone due strade per l'accesso server-side:
#
#   A) Cloud API diretta  (https://platform.higgsfield.ai)  [DEFAULT]
#      Auth: "Authorization: Key KEY_ID:KEY_SECRET"
#      - HIGGSFIELD_API_KEY=KEY_ID:KEY_SECRET  (le due parti separate da `:`)
#      - HIGGSFIELD_AUTH_PREFIX=Key            (nota lo SPAZIO dopo "Key")
#      - HIGGSFIELD_IMAGE_ENDPOINT=/v1/text2image/soul
#      - HIGGSFIELD_VIDEO_ENDPOINT=/v1/image2video/dop
#      La key la trovi su platform.higgsfield.ai → sezione API/Developers,
#      oppure dopo aver fatto `higgsfield auth login` con la CLI ufficiale
#      (`npm i -g @higgsfield/cli`).
#
#   B) Segmind serverless proxy (https://api.segmind.com)
#      - HIGGSFIELD_API_BASE_URL=https://api.segmind.com/v1
#      - HIGGSFIELD_AUTH_HEADER=x-api-key
#      - HIGGSFIELD_AUTH_PREFIX=    (vuoto)
#      - HIGGSFIELD_IMAGE_ENDPOINT=/higgsfield-soul
#      - HIGGSFIELD_VIDEO_ENDPOINT=/higgsfield-seedance
#
# Se HIGGSFIELD_API_KEY è vuoto OPPURE MOCK_LLM=true, il sistema usa il
# mock SVG/video placeholder (nessuna spesa, utile per dev locale).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_BASE_URL=https://platform.higgsfield.ai
HIGGSFIELD_AUTH_HEADER=Authorization
HIGGSFIELD_AUTH_PREFIX=Key
HIGGSFIELD_IMAGE_ENDPOINT=/v1/text2image/soul
HIGGSFIELD_VIDEO_ENDPOINT=/v1/image2video/dop
# Quality di default per Soul: "720p" o "1080p".
HIGGSFIELD_IMAGE_QUALITY=1080p
# Modello video di default (DoP variant).
HIGGSFIELD_VIDEO_MODEL=dop-turbo
# Polling: intervallo (ms) tra check status e numero max di tentativi.
# Default video 1080p possono richiedere 2-3 minuti, alziamo il timeout.
HIGGSFIELD_POLL_INTERVAL_MS=3000
HIGGSFIELD_MAX_POLL_ATTEMPTS=120

# Endpoint Seedance 1.0 Pro su Higgsfield platform (composizione video da
# keyframe). La 2.0 non ha API pubblica al momento, usiamo la 1.0 Pro
# documentata. Path: /bytedance/seedance/v1/pro/image-to-video
HIGGSFIELD_SEEDANCE_ENDPOINT=/bytedance/seedance/v1/pro/image-to-video

# =========================================================================
# n8n (verrà aggiunto in fase successiva)
# =========================================================================
N8N_WEBHOOK_BASE_URL=http://localhost:5678
N8N_WEBHOOK_SECRET=change_me

# =========================================================================
# STORAGE
# =========================================================================
# Provider attivo: 'local' (filesystem) o 's3'
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage

# Configurazione S3 (usata solo se STORAGE_PROVIDER=s3)
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=

# =========================================================================
# PAGAMENTI (verranno usati quando attiveremo il flusso pagamento)
# =========================================================================
# Mock payments: se true (default in dev), il pagamento è simulato.
# Mettere false + configurare Stripe per pagamenti reali.
# MOCK_PAYMENTS: se "true" (default in dev) il pagamento è simulato istantaneo
# senza toccare Stripe. Se "false" e STRIPE_SECRET_KEY è valorizzata, il
# cliente viene reindirizzato a Stripe Checkout reale (test o live in base
# al prefisso della key).
MOCK_PAYMENTS=true

# Stripe Checkout integration (Setup 14).
# - sk_test_... → test mode (carte di prova, nessuna spesa reale)
# - sk_live_... → live mode (carte reali, soldi veri)
# Genera le key su https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# whsec_..., generato in 2 modi:
#  - dev:  `stripe listen --forward-to localhost:3002/api/stripe/webhook` → copia la stringa printata
#  - prod: Dashboard Stripe → Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_... / pk_live_...). Non usata ora dal backend ma
# servirà se aggiungeremo Stripe Elements/Stripe.js lato client in V2.
STRIPE_PUBLISHABLE_KEY=
# Versione API Stripe (opzionale, default ragionevole nel codice).
STRIPE_API_VERSION=

# URL pubblico del client portal, usato per costruire success/cancel URLs
# nella Checkout Session. In dev: 3001 (vedi script dev di apps/client).
APP_CLIENT_URL=http://localhost:3001

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# =========================================================================
# MAIL TRANSAZIONALE (Email Composer Agent — Setup 15)
# =========================================================================
#
# MOCK_EMAILS: se "true" il mailer logga in console invece di inviare davvero.
# Default in dev: false (se SMTP_HOST è settato, invia per davvero).
# Per disabilitare invio reale anche con SMTP configurato, metti "true".
MOCK_EMAILS=false
#
# Configurazione SMTP per agency@kansei-studio.art:
#   Server in entrata: mail.kansei-studio.art porta IMAP 993
#   Server in uscita:  mail.kansei-studio.art porta SMTP 465 (SSL/TLS)
SMTP_HOST=mail.kansei-studio.art
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=agency@kansei-studio.art
# ⚠️ NON committare mai la password vera qui. Mettila SOLO nel tuo .env locale.
SMTP_PASSWORD=your_smtp_password_here
#
# Mittente mostrato nelle email inviate.
MAIL_FROM_ADDRESS=agency@kansei-studio.art
MAIL_FROM_NAME="Kansei-Studio Agency"
